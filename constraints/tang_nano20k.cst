// ---------------------------------------------------------------------------
// Physical constraints for PC Engine on the Sipeed Tang Nano 20K
// Device: GW2AR-LV18QN88C8/I7  (GW2AR-18C)
//
// Pin numbers taken from the official Sipeed Tang Nano 20K examples
// (https://github.com/sipeed/TangNano-20K-example).
//
// The GW2AR on-package SDRAM is hard wired inside the package; its signals are
// placed automatically by the tools from the reserved O_sdram_* / IO_sdram_dq
// port names and must therefore NOT be constrained here.
// ---------------------------------------------------------------------------

// 27 MHz reference clock
IO_LOC  "sys_clk" 4;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// on-board push buttons (active high when pressed)
IO_LOC  "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "s2" 87;
IO_PORT "s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// on-board BL616 USB <-> serial bridge
IO_LOC  "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// on-board LEDs (active low)
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// on-board microSD socket, driven in SPI mode (not SD native 1-bit mode):
//   sd_clk   SCK                  (output, pin 83)
//   sd_cmd   MOSI  (card CMD)     (output, pin 82)
//   sd_dat0  MISO  (card DAT0)    (input,  pin 84)
//   sd_dat3  CS    (card DAT3)    (output, pin 81, held low)
//   sd_dat1  DAT1                 (output, pin 85, held high as SPI mode wants)
//   sd_dat2  DAT2                 (output, pin 80, held high)
// The board already has the pull-ups the card needs, so PULL_MODE=NONE.
IO_LOC  "sd_clk" 83;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_cmd" 82;
IO_PORT "sd_cmd" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat0" 84;
IO_PORT "sd_dat0" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "sd_dat1" 85;
IO_PORT "sd_dat1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat2" 80;
IO_PORT "sd_dat2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_dat3" 81;
IO_PORT "sd_dat3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// on-board SPI NOR flash, which also holds the FPGA bitstream.  These are the
// MSPI dual-purpose pins; they are released by the configuration engine once
// the bitstream has been read, and "Use MSPI as regular IO" must be enabled in
// the project's dual-purpose pin settings for the placer to accept them.
// The PicoRV32 firmware image lives at flash offset 0x500000.
IO_LOC  "flash_spi_cs_n" 60;
IO_PORT "flash_spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_spi_wp_n" 57;
IO_PORT "flash_spi_wp_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_spi_hold_n" 63;
IO_PORT "flash_spi_hold_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_spi_miso" 62;    // MSPI_DO
IO_PORT "flash_spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_spi_mosi" 61;    // MSPI_DI
IO_PORT "flash_spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "flash_spi_clk" 59;
IO_PORT "flash_spi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// HDMI TX
IO_LOC "tmds_d_p[0]" 35,36;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[1]" 37,38;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_d_p[2]" 39,40;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// on-board I2S audio amplifier / headphone jack.
// Pins 54/55/56 are the SSPI dual-purpose pins, so "Use SSPI as regular IO"
// must be enabled in the project's dual-purpose pin settings or the placer
// rejects them with PR2017 ("the location is a dedicated pin (SSPI)").
IO_LOC  "pa_en" 51;
IO_PORT "pa_en" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "hp_din" 54;
IO_PORT "hp_din" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "hp_ws" 55;
IO_PORT "hp_ws" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "hp_bck" 56;
IO_PORT "hp_bck" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// external SNES style game pad (3.3 V only!)
//   pin 27 -> pad CLOCK
//   pin 28 -> pad LATCH
//   pin 25 <- pad DATA (pulled up on chip)
IO_LOC  "pad_clk" 27;
IO_PORT "pad_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "pad_latch" 28;
IO_PORT "pad_latch" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "pad_data" 25;
IO_PORT "pad_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;
